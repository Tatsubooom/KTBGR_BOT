# ===== Discord =====
DISCORD_TOKEN=
# 指定するとそのサーバーにだけ即座にスラッシュコマンドを反映 (未指定ならグローバル同期で反映に時間がかかる)
GUILD_ID=
# 反応メッセージの送信先チャンネルID (未指定ならVC内蔵のテキストチャット)
RESPONSE_CHANNEL_ID=
# 文字起こし結果を全文チャットに流すか
POST_TRANSCRIPTS=false

# ===== 文字起こし =====
# auto: GPUがあればGPU、なければCPU / cuda: GPU固定 / cpu: CPU固定
WHISPER_DEVICE=auto
# tiny / base / small / medium / large-v3 / large-v3-turbo など (大きいほど高精度・低速)
WHISPER_MODEL=small
# default なら GPU=float16, CPU=int8
WHISPER_COMPUTE_TYPE=default
WHISPER_LANGUAGE=ja
WHISPER_BEAM_SIZE=1

# ===== リアルタイム性の調整 =====
# この時間無音が続いたら発話を確定して文字起こし
SILENCE_MS=450
# 話している途中でもこの間隔で文字起こししてキーワードを早期検出 (0で無効、CPUなら 1500〜2000 推奨)
PARTIAL_INTERVAL_MS=1000
# 1回の文字起こしの最大長 (秒)
MAX_SEGMENT_SEC=8
# これより短い発話は無視 (咳・物音対策)
MIN_SPEECH_MS=250
# 音量がこれ未満のフレームは無音扱い (0.0〜1.0)
ENERGY_THRESHOLD=0.008

# ===== キーワード検出 =====
# カンマ区切りで複数指定可 (data/inmu_goroku.json は淫夢語録 約450件)
KEYWORDS_FILE=keywords.json,data/inmu_goroku.json
# 曖昧一致の類似度しきい値 (0〜100、低いほど緩い)
MATCH_THRESHOLD=70
# 同じ人が同じキーワードで連続反応しない秒数
COOLDOWN_SEC=5
# VC で同じ人がこの秒数以内に続けて語録を言ったらコンボ継続 (反応メッセージを編集して伸ばす、0で無効)
# テキストチャットは1メッセージ内の検出がコンボになる
COMBO_WINDOW_SEC=8

# ===== テキストチャット =====
# テキストチャットの発言にも反応するか (Developer Portal で MESSAGE CONTENT INTENT の有効化が必要)
TEXT_CHAT=true
# 反応するチャンネルID (カンマ区切り、未指定なら全チャンネル)
TEXT_CHANNEL_IDS=
